<launch>

    <group ns="tb3_1">
        <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
            <arg name="multi_robot_name" value="tb3_1"/>
        </include>
    </group>

    <group ns="tb3_2">
        <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
            <arg name="multi_robot_name" value="tb3_2"/>
        </include>
    </group>

</launch>