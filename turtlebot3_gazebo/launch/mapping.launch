<launch>

    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping">
        <param name="map_update_interval" value="0.5"/>
        <param name="delta" value="0.02"/>
        <param name="linearUpdate" value="0.05"/>
        <param name="angularUpdate" value="0.02"/>
        <!-- <param name="map_frame" value="tb3_1/map"/>
        <param name="odom_frame" value="tb3_1/odom"/>
        <param name="base_frame" value="tb3_1/base_link"/>         -->
        <!-- <param name="base_footprint_frame" value="tb3_1/base_footprint"/>   -->
    </node>

</launch>